# Application
NODE_ENV=development
PORT=3000

# Database (Supabase PostgreSQL with Multi-Schema store & logistics)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=store

# Redis (BullMQ queue broker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase Storage & Client
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Webhooks & Security
WEBHOOK_SECRET_DEFAULT=secret_webhook_signing_key_for_hmac
