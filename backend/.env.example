# Application
NODE_ENV=development
PORT=3000

# Database (Supabase PostgreSQL with Multi-Schema store & logistics)
# DATABASE_URL uses connection pooler (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL uses direct connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API & Storage
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Redis (BullMQ queue broker - Upstash TCP / ioredis)
# In Upstash Dashboard -> Details -> "Connect your database" -> Select "ioredis" or "Node.js (ioredis)"
REDIS_URL="rediss://default:[UPSTASH_PASSWORD]@capable-sheep-210678.upstash.io:6379"
# Or separated:
REDIS_HOST="capable-sheep-210678.upstash.io"
REDIS_PORT=6379
REDIS_PASSWORD="[UPSTASH_PASSWORD]"

# Webhooks & Security
WEBHOOK_SECRET_DEFAULT=dev_secret_key_123
