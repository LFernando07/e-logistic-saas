generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["store", "logistics"]
}

// ----------------------------------------------------
// ENUMS - STORE SCHEMA
// ----------------------------------------------------

enum UserRole {
  ADMIN
  MERCHANT
  CUSTOMER

  @@schema("store")
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED

  @@schema("store")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED

  @@schema("store")
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RESTOCKED

  @@schema("store")
}

enum PaymentProvider {
  STRIPE
  SIMULATED
  MANUAL

  @@schema("store")
}

// ----------------------------------------------------
// ENUMS - LOGISTICS SCHEMA
// ----------------------------------------------------

enum CarrierCode {
  MOCK
  FEDEX
  DHL
  ESTAFETA
  SKYDROPX
  SHIPPO

  @@schema("logistics")
}

enum ShipmentStatus {
  DRAFT
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  CANCELLED

  @@schema("logistics")
}

enum TrackingEventStatus {
  LABEL_CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED

  @@schema("logistics")
}

// ----------------------------------------------------
// MODELS - STORE SCHEMA
// ----------------------------------------------------

model Tenant {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  domain           String?  @unique
  brandingSettings Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users           User[]
  products        Product[]
  orders          Order[]
  payments        Payment[]
  carrierAccounts CarrierAccount[]
  shipments       Shipment[]

  @@index([slug])
  @@schema("store")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(CUSTOMER)
  tenantId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId])
  @@index([email])
  @@schema("store")
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  slug        String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([category])
  @@schema("store")
}

model ProductVariant {
  id                String   @id @default(uuid())
  productId         String
  sku               String   @unique
  title             String
  price             Decimal  @db.Decimal(10, 2)
  compareAtPrice    Decimal? @db.Decimal(10, 2)
  inventoryQuantity Int      @default(0)
  weightGrams       Int      @default(0)
  lengthCm          Decimal? @db.Decimal(8, 2)
  widthCm           Decimal? @db.Decimal(8, 2)
  heightCm          Decimal? @db.Decimal(8, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
  @@schema("store")
}

model Order {
  id                String            @id @default(uuid())
  tenantId          String
  orderNumber       String
  userId            String?
  customerEmail     String
  customerPhone     String?
  shippingAddress   Json
  billingAddress    Json?
  currency          String            @default("USD")
  subtotal          Decimal           @db.Decimal(10, 2)
  shippingFee       Decimal           @default(0) @db.Decimal(10, 2)
  taxTotal          Decimal           @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal           @db.Decimal(10, 2)
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  shipment Shipment?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerEmail])
  @@index([status])
  @@schema("store")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  variantId   String
  sku         String
  title       String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  weightGrams Int      @default(0)
  createdAt   DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@schema("store")
}

model Payment {
  id            String          @id @default(uuid())
  orderId       String
  tenantId      String
  provider      PaymentProvider @default(STRIPE)
  transactionId String?
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("USD")
  status        PaymentStatus   @default(PENDING)
  rawResponse   Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@index([transactionId])
  @@schema("store")
}

// ----------------------------------------------------
// MODELS - LOGISTICS SCHEMA
// ----------------------------------------------------

model CarrierAccount {
  id                   String      @id @default(uuid())
  tenantId             String
  carrierCode          CarrierCode
  accountName          String
  credentialsEncrypted Json
  isSandbox            Boolean     @default(true)
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipments Shipment[]

  @@index([tenantId])
  @@index([carrierCode])
  @@schema("logistics")
}

model Shipment {
  id                  String         @id @default(uuid())
  tenantId            String
  orderId             String?        @unique
  carrierAccountId    String?
  carrierCode         CarrierCode
  serviceCode         String
  trackingNumber      String         @unique
  status              ShipmentStatus @default(LABEL_CREATED)
  labelUrl            String?
  zplUrl              String?
  originAddress       Json
  destinationAddress  Json
  rateAmount          Decimal?       @db.Decimal(10, 2)
  currency            String         @default("USD")
  estimatedDeliveryAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  carrierAccount CarrierAccount?   @relation(fields: [carrierAccountId], references: [id], onDelete: SetNull)
  packages       ShipmentPackage[]
  trackingEvents TrackingEvent[]

  @@index([tenantId])
  @@index([trackingNumber])
  @@index([status])
  @@index([carrierCode])
  @@schema("logistics")
}

model ShipmentPackage {
  id           String   @id @default(uuid())
  shipmentId   String
  weightKg     Decimal  @db.Decimal(8, 3)
  lengthCm     Decimal  @db.Decimal(8, 2)
  widthCm      Decimal  @db.Decimal(8, 2)
  heightCm     Decimal  @db.Decimal(8, 2)
  packageType  String   @default("BOX")
  insuredValue Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@schema("logistics")
}

model TrackingEvent {
  id             String              @id @default(uuid())
  shipmentId     String
  status         TrackingEventStatus
  rawStatus      String
  description    String
  location       String?
  eventTimestamp DateTime
  carrierCode    CarrierCode
  rawPayload     Json?
  createdAt      DateTime            @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([status])
  @@index([eventTimestamp])
  @@schema("logistics")
}

model RateCache {
  id             String      @id @default(uuid())
  cacheKey       String      @unique
  originZip      String
  destinationZip String
  weightKg       Decimal     @db.Decimal(8, 3)
  carrierCode    CarrierCode
  serviceCode    String
  rateAmount     Decimal     @db.Decimal(10, 2)
  currency       String      @default("USD")
  expiresAt      DateTime
  createdAt      DateTime    @default(now())

  @@index([cacheKey])
  @@index([expiresAt])
  @@schema("logistics")
}
